    try {
        if (cus_password) {
            // Hash the new password before updating the profile
            const hashedPassword = await bcrypt.hash(cus_password, 10);
            data.cus_password = hashedPassword;
        }

        db.query("UPDATE customers SET ? WHERE cus_nic = ?", [otherData, id], (err, results) => {
            if (err) {
